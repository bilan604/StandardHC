@charset "utf-8";
/* CSS Document */
/* 公共样式 */
body {font-family:"宋体"; font-family:Verdana; margin:0; padding:0; background:#fff; font-size:12px; color:#444;}
div,form,img,ul,ol,li,dl,dt,dd p{margin:0px; padding:0px; border:0px; text-decoration:none;}
li,dl{ display:inline; list-style-type:none;}
h1,h2,h3,h4,h5,h6 { margin:0; padding:0;font-size:12px; font-weight:normal;}

img{ display:block;}
.clear{height:0px;line-height:0px;font-size:0px;overflow:hidden;clear:both;}
a{ color:#444; text-decoration:none;}
a:hover{ color:#444; text-decoration:none;}
.boxk{ width:790px; margin:10px; text-align:left}
.leftk{ width:531px; border:1px solid #a8c7ce; padding:1px; float:left;}
.titk{ width:100%; height:31px; background: url(../images/title.jpg) repeat-x; color:#fff; line-height:30px;}
.left_nrk{ width:100%; padding-top:1px; padding-bottom:28px;}

.rightk{ width:244px; float:right;}
.right_topk{ width:242px; border:1px solid #a8c7ce; padding:1px;}
.tit_textk{ padding-left:30px;}
.right_nrk{ width:222px; padding:10px 10px 40px 10px;}
.right_nrk ul{ width:100%; margin:0px;}
.right_nrk li{ width:212px; color:#ff0000; background:url(../iamges/icon.jpg) no-repeat; padding-left:10px; text-decoration:none; line-height:16px; margin-bottom:14px; display: block;}
.right_nrk li a,.right_nrk li a:hover{ color:#FF0000;}
.detak{ color:#868686; font-size:10px; font-family:Arial, Helvetica, sans-serif; padding-left:10px;}

.right_bottomk{ width:222px; border:1px solid #a8c7ce; padding:10px; margin-top:6px; display: block; color:#999999;}
h1{ color:#111; font-size:12px; font-weight: normal; line-height:30px;}
.right_textk{ line-height:22px;}