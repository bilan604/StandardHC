# ~form 开头的内容用于指定表单属性
~form:
  _subject: "添加品牌"
  _addanother: true
  _continue: true
 
# 指定字段及过滤器等信息
name:
  _ui: textbox
  _label: "品牌名"
  _req: true
  class: "vTextField"

logo:
  _ui: textbox
  _label: "Logo图片"
  _req: true
  class: "vTextField"

description:
  _ui: fckeditor
  _label: "品牌介绍"