# ~form 开头的内容用于指定表单属性
~form:
  _subject: "Change email address"
  _continue: true
 
# 指定字段及过滤器等信息
title:
  _ui: textbox
  _label: "E-mail subject"
  _req: true
  class: "vTextField"

mail1:
  _ui: textbox
  _label: "E-mail address 1"
  _req: true
  class: "vTextField"

mail2:
  _ui: textbox
  _label: "E-mail address 2"
  class: "vTextField"