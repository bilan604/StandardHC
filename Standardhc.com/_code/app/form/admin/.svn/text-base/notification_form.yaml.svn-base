# ~form 开头的内容用于指定表单属性
~form:
  _subject: "添加站内通知"
  _addanother: true
  _continue: true

# 指定字段及过滤器等信息

title:
  _ui: textbox
  _filters: ['trim', 'strtolower']
  _label: "通知标题"
  _req: true
  size: 60

content:
  _ui: kindeditor
  _label: "通知内容"
  class: "vLargeTextField"
  cols: 100
  rows: 12
  _req: true

hits:
  _ui: textbox
  _label: "点击数"

language:
  _ui: dropdownlist
  _label: "语言"