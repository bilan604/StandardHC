# ~form 开头的内容用于指定表单属性
~form:
  _subject: "Change password"
 
# 指定字段及过滤器等信息
username:
  _ui: textbox
  _filters: ['trim', 'strtolower']
  _label: "Username"
  _req: true
  class: "vTextField"
  readonly: true

oldpassword:
  _ui: password
  _label: "Old password"
  class: "vTextField"
  _tips: ""

password:
  _ui: password
  _label: "New password"
  class: "vTextField"

confirmpassword:
  _ui: password
  _label: "Confirm password"
  class: "vTextField"

id:
  _ui: hidden