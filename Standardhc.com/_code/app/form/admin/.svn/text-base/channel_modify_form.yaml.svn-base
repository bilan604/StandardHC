# ~form 开头的内容用于指定表单属性
~form:
  _subject: "Add category"
  _addanother: true
  _continue: true
 
# 指定字段及过滤器等信息
parentid:
  _ui: hidden

name:
  _ui: textbox
  _filters: ['trim']
  _label: "Name"
  _req: true
  _tips: "50 characters or fewer."
  class: "vTextField"

po_name:
  _ui: textbox
  _filters: ['trim']
  _label: "Portuguese Name"
  _tips: "50 characters or fewer."
  class: "vTextField"

picurl:
  _ui: upload
  _label: "Picture"
  class: "vTextField"

oldpicurl:
  _ui: textbox
  _label: "Picture path"
  class: "vTextField"

description:
  _ui: memo
  _label: "English Description"
  class: "vlargeTextField"
  rows: 6
  cols: 40

po_description:
  _ui: memo
  _label: "Portuguese Description"
  class: "vlargeTextField"
  rows: 6
  cols: 40

order:
  _ui: textbox
  _label: "Sort"
  _tips: "Order by digest desc"
  size: 5