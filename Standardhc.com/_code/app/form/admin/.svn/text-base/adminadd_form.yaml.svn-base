# ~form 开头的内容用于指定表单属性
~form:
  _subject: "Add manager"
  _addanother: true
#  _continue: true
 
# 指定字段及过滤器等信息
username:
  _ui: textbox
  _filters: ['trim', 'strtolower']
  _label: "Username"
  _req: true
  _tips: ""
  class: "vTextField"

password:
  _ui: password
  _label: "Password"
  _req: true
  class: "vTextField"

confirmpassword:
  _ui: password
  _label: "Comfirme password"
  _req: true
  class: "vTextField"