# ~form 开头的内容用于指定表单属性
~form:
  _subject: "在线订车"
  _reset: true
 
# 指定字段及过滤器等信息

name:
  _ui: textbox
  _label: "Name"
  class: feedback_input

company:
  _ui: textbox
  _label: "Company"
  class: feedback_input

phone:
  _ui: textbox
  _label: "Phone"
  class: feedback_input

email:
  _ui: textbox
  _label: "Email"
  class: feedback_input

address:
  _ui: textbox
  _label: "Address"
  class: feedback_input

fax:
  _ui: textbox
  _label: "Fax"
  class: feedback_input

message:
  _ui: memo
  _label: "Content"
  cols: 50
  rows: 6
  class: feedback_input
