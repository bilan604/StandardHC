# ~form 开头的内容用于指定表单属性
~form:
  _subject: "User"
 
# 指定字段及过滤器等信息

password:
  _ui: password
  _label: "新密码"
  _req: true
  size: 30
  max_length: 20
  class: "input2"

oldpassword:
  _ui: password
  _label: "原密码"
  _req: true
  size: 30
  max_length: 20
  class: "input2"

confirmpassword:
  _ui: password
  _label: "确认密码"
  _req: true
  size: 30
  max_length: 20
  class: "input2"