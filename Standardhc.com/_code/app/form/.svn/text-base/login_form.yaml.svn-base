# ~form 开头的内容用于指定表单属性
~form:
  _subject: "User"
 
# 指定字段及过滤器等信息
nick:
  _ui: textbox
  _filters: ['trim', 'strtolower']
  _label: "用户名"
  _req: true
  max_length: 64
  size: 40
  class: "sign_input"

password:
  _ui: password
  _label: "密码"
  _req: true
  max_length: 32
  size: 40
  class: "sign_input"