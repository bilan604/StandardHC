page_content:
  _lab: lab_common
  _ui: kindeditor
  _req: true
  _label: "内容"

page_banner:
  _lab: lab_img
  _ui: upload
  _label: "Banner"
  _help: "“请上传大小为 1400 * 217 的图片”"
  _req: true
  class: "vUploadField"

page_image:
  _ui: upload
  _label: "页面右侧图片（大）"
  _help: "“请上传大小为 279 * 125 的图片，用于宽屏的浏览器中显示”"
  _req: true
  class: "vUploadField"

page_image_small:
  _ui: upload
  _label: "页面右侧图片（小）"
  _help: "“请上传大小为 180 * 81 的图片，用于窄屏的浏览器中显示”"
  _req: true
  class: "vUploadField"

seo_title:
  _lab: lab_seo
  _ui: textbox
  _label: "SEO标题"
  class: "vTextField"

seo_keywords:
  _ui: memo
  _label: "SEO关键词"
  class: "vMultipleTextField"

seo_description:
  _ui: memo
  _label: "SEO描述信息"
  class: "vMultipleTextField"